# -----------------------------------------------------------------------------
# Yosys Synthesis Script for SkyWater 130nm PDK (LFSR-NFSR PRNG)
# -----------------------------------------------------------------------------

# 1. Read Verilog RTL Source Files
read_verilog flow_130nm_skywater/rtl/LFSR.v flow_130nm_skywater/rtl/NFSR.v flow_130nm_skywater/rtl/keystream.v flow_130nm_skywater/rtl/encrypt.v flow_130nm_skywater/rtl/decrypt.v flow_130nm_skywater/rtl/lfsr_nfsr_top.v

# 2. Set Top Level Module
hierarchy -check -top lfsr_nfsr_top

# 3. Translate RTL processes to generic gates
proc
opt
fsm
opt

# 4. Map Logic Gates
abc -g AND,NAND,OR,NOR,XOR,XNOR,MUX

# 5. Flatten & Clean
flatten
clean

# 6. Export Synthesized Netlist
write_verilog flow_130nm_skywater/results/synth_netlist_sky130.v

# 7. Print Cell Utilization Report
stat
